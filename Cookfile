# ============================================================
#  dhewm3 — Doom 3 source port, built with Cook
#
#  Linux build. The engine, its built-in compilers (dmap,
#  runaas), and the asset pipeline that USES those compilers
#  all live in one DAG. `cook game` builds the binary and
#  bakes every map in one parallel run, with full caching.
# ============================================================

use cook_cc

register
    cook_cc.toolchain({ standard = "c++14", warnings = "none" })

    cook_cc.defaults({
        defines      = { "_GNU_SOURCE", "ID_PC_LINUX", "USE_OPENAL",
                         -- x86_64 / x86 / arm / arm64 are all little-endian.
                         -- dhewm3's CMakeLists uses TestBigEndian for this.
                         "D3_IS_BIG_ENDIAN=0",
                         -- Host bitness + arch tag — CMakeLists derives these
                         -- from CMAKE_SIZEOF_VOID_P and `-dumpmachine` parsing.
                         -- Hardcoded to 64-bit x86_64 for this Linux-only fork.
                         "D3_SIZEOFPTR=8",
                         "D3_ARCH=\\\"x86_64\\\"",
                         "D3_OSTYPE=\\\"linux\\\"",
                         -- W13 workaround: build the engine with ImGui
                         -- disabled. The dearimgui lib alone trips a flaky
                         -- cook-core lua-eval error (under investigation).
                         "IMGUI_DISABLE" },
        extra_cflags = "-fno-strict-aliasing -fvisibility=hidden",
    })

    -- ----- Source-list helper --------------------------------
    -- dhewm3 keeps a handful of dead .cpp files in the tree that the
    -- upstream CMakeLists explicitly omits. `srcs(dir, excludes)` is the
    -- tight glob + exclude pattern.
    local function srcs(dir, excludes)
        local skip = {}
        for _, e in ipairs(excludes or {}) do skip[e] = true end
        local out = {}
        for _, ext in ipairs({ "*.cpp", "*.c" }) do
            for _, s in ipairs(fs.glob(dir .. "/**/" .. ext)) do
                local rel = s:sub(#dir + 2)        -- strip "dir/" prefix
                if not skip[rel] then out[#out + 1] = s end
            end
        end
        return out
    end

    -- ----- Configure header (replaces CMake's configure_file) -------

    local cfg = cook_cc.config_header(
        "neo/config.h.in",
        "build/dhewm3/config.h",
        {
            os                          = "linux",
            cpu                         = "x86_64",
            CMAKE_SHARED_LIBRARY_SUFFIX = ".so",
            libdir                      = "",
            datadir                     = "",
            HAVE_JPEG_MEM_SRC           = true,
            ID_ENABLE_CURL              = true,
        }
    )

    -- ----- Engine static libs (in dependency order) ----------

    cook_cc.lib("idLib", {
        -- Bare `includes` is used by the target itself AND exported to
        -- consumers via the CS-0080 backcompat fall-back (includes is the
        -- only field where bare → public propagation still applies).
        -- build/dhewm3 carries the generated config.h.
        sources  = srcs("neo/idlib", { "geometry/Surface_Polytope.cpp",
                                       "math/Complex.cpp" }),
        includes = { "neo", "neo/idlib", "build/dhewm3" },
        defines  = { "ID_LIB_INTERNAL" },
        -- SDL2 ships idlib's endian macros; needed for compile, not link.
        needs    = { "SDL2" },
        requires = { cfg },
    })

    cook_cc.lib("framework", { sources = srcs("neo/framework"), links = { "idLib" },                          needs = { "SDL2" }, requires = { cfg } })
    cook_cc.lib("cm",        { sources = srcs("neo/cm"),        links = { "idLib" },                          needs = { "SDL2" }, requires = { cfg } })
    cook_cc.lib("ui",        { sources = srcs("neo/ui", { "GameWindow.cpp" }), links = { "idLib", "framework" }, needs = { "SDL2" }, requires = { cfg } })

    -- Dear ImGui is vendored under neo/libs/imgui. DISABLED via the
    -- IMGUI_DISABLE define in defaults above; pending the W13 cook fix.
    -- The sys lib drops sys_imgui.cpp + imgui_savestyle.cpp because they
    -- bring in imgui headers unconditionally.

    cook_cc.lib("renderer", {
        sources  = srcs("neo/renderer"),
        links    = { "idLib", "framework" },
        -- W13 workaround: `needs = {"GL"}` trips a flaky probe-scheduler
        -- race ("attempt to index a nil value" in pool.rs). GL headers
        -- are on the default system include path (/usr/include/GL/);
        -- `-lGL` is hand-wired on the binary's extra_ldflags below.
        needs    = { "SDL2" },
        requires = { cfg },
    })

    cook_cc.lib("sound", {
        sources  = srcs("neo/sound"),
        links    = { "idLib", "framework" },
        needs    = { "OpenAL", "SDL2" },
        requires = { cfg },
    })

    -- gamecode and d3xp need their own dir on includes for intra-lib
    -- relative header references. Upstream uses HARDLINK_GAME for this.
    -- Note: lib named gamecode not game so it does not shadow recipe game.
    cook_cc.lib("gamecode", {
        sources  = srcs("neo/game", { "EndLevel.cpp", "gamesys/Callbacks.cpp" }),
        includes = { "neo/game" },
        defines  = { "GAME_DLL" },             -- declares DLL-side engine pointers
        links    = { "idLib", "framework", "cm", "renderer", "sound", "ui" },
        needs    = { "SDL2" },
        requires = { cfg },
    })

    cook_cc.lib("d3xp", {
        sources  = srcs("neo/d3xp", { "EndLevel.cpp", "gamesys/Callbacks.cpp" }),
        includes = { "neo/d3xp" },
        defines  = { "GAME_DLL", "_D3XP" },    -- _D3XP gates D3XP-specific code
        links    = { "idLib", "framework", "cm", "renderer", "sound", "ui" },
        needs    = { "SDL2" },
        requires = { cfg },
    })

    cook_cc.lib("compilers", {
        sources  = srcs("neo/tools/compilers"),
        links    = { "idLib", "framework", "renderer", "cm" },
        needs    = { "SDL2" },
        requires = { cfg },
    })

    -- ----- Platform abstraction (per-OS source selection) ----
    -- sys lib: the SDL-using sys/*.cpp + POSIX helpers. The Linux entry
    -- point (sys/linux/main.cpp) is the binary's source, not the lib's,
    -- to avoid duplicating main() at link time.

    local sys_sources = {}
    for _, s in ipairs(fs.glob({ "neo/sys/*.cpp" })) do
        -- W13 workaround: drop imgui-touching files (IMGUI_DISABLE is set).
        if not s:match("imgui") then sys_sources[#sys_sources + 1] = s end
    end
    if cook.platform.os == "linux" then
        for _, s in ipairs(fs.glob({ "neo/sys/posix/*.cpp" })) do
            table.insert(sys_sources, s)
        end
    end

    cook_cc.lib("sys", {
        sources  = sys_sources,
        links    = { "idLib", "framework" },
        needs    = { "SDL2" },
        requires = { cfg },
    })

    -- ----- The dhewm3 binary: engine + game + compilers ------

    cook_cc.bin("dhewm3", {
        sources       = {
            "neo/sys/linux/main.cpp",
            -- DebuggerServer stubs needed by framework's Common.cpp.
            "neo/tools/debugger/DebuggerServer.cpp",
            "neo/tools/debugger/DebuggerScript.cpp",
            "neo/tools/debugger/debugger.cpp",
        },
        links         = { "sys", "framework", "renderer", "sound", "cm", "ui",
                          "gamecode", "d3xp", "compilers" },
        needs         = { "SDL2" },
        -- W18: engine libs have circular symbol references; re-list inside
        -- a --start-group so ld can multi-pass resolve.
        -- W13 + W19: hand-wire -lGL/-lopenal/-lcurl/-lz instead of going
        -- through needs={} (probe-scheduler race in cook bites with these).
        extra_ldflags = "-Wl,--start-group build/lib/libsys.a build/lib/libframework.a build/lib/libidLib.a build/lib/librenderer.a build/lib/libcm.a build/lib/libsound.a build/lib/libui.a build/lib/libgamecode.a build/lib/libd3xp.a build/lib/libcompilers.a -Wl,--end-group -lGL -lopenal -lcurl -lz -lm -lpthread -ldl",
        requires      = { cfg },
    })

# ============================================================
#  Asset pipeline — same DAG, dhewm3 is the tool
# ============================================================
#  `$<dhewm3>` in each cook command IS the cross-recipe dep:
#  the engine infers that every map output needs dhewm3
#  rebuilt. `$<in.stem>` fans the step out, one unit per .map.

recipe maps
    ingredients "base/maps/*.map"

    cook "base/maps/$<in.stem>.proc" "base/maps/$<in.stem>.cm" using {
        $<dhewm3> +dmap $<in> +quit
    }

    cook "base/maps/$<in.stem>.aas48"
         "base/maps/$<in.stem>.aas96"
         "base/maps/$<in.stem>.aas120" using {
        $<dhewm3> +runaas $<in> +quit
    }

recipe game : dhewm3 maps

recipe compile-commands : dhewm3
    >> cook_cc.compile_commands()

chore clean
    rm -rf build .cook
