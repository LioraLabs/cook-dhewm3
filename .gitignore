# User-provided game assets. A legal Doom 3 install is required to run the
# game, and its copyrighted data must NEVER be committed. The blanket *.pk4
# rule guards base/, d3xp/, and any mod dir; the rest covers dmap/runaas-
# derived assets.
*.pk4
/base/maps/*.proc
/base/maps/*.cm
/base/maps/*.aas48
/base/maps/*.aas96
/base/maps/*.aas120
/d3xp/maps/*.proc
/d3xp/maps/*.cm
/d3xp/maps/*.aas48
/d3xp/maps/*.aas96
/d3xp/maps/*.aas120


# engine droppings when fs_savepath is pinned to the repo
/base/consolehistory.dat
/d3xp/consolehistory.dat
/base/dhewm3.cfg
/d3xp/dhewm3.cfg
dhewm3log*.txt

# upstream cmake build dir (side-by-side comparison builds)
/build-cmake/
